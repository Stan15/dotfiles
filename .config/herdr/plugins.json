[
  {
    "plugin_id": "claude-auto-retry",
    "name": "Claude Auto Retry",
    "version": "1.0.0",
    "min_herdr_version": "0.7.0",
    "description": "Wait out Anthropic rate limits and auto-resume Claude Code panes, herdr-native (no tmux, no shell wrapper).",
    "manifest_path": "/Users/stans/dotfiles/.config/herdr/plugins/github/claude-auto-retry-fadcd8f12448/herdr-plugin.toml",
    "plugin_root": "/Users/stans/dotfiles/.config/herdr/plugins/github/claude-auto-retry-fadcd8f12448",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "actions": [
      {
        "id": "arm",
        "title": "Claude Auto Retry: watch this pane",
        "description": "Attach an auto-retry monitor to the focused Claude Code pane.",
        "contexts": [
          "pane"
        ],
        "command": [
          "/bin/sh",
          "launch.sh",
          "arm"
        ]
      },
      {
        "id": "logs",
        "title": "Claude Auto Retry: logs",
        "description": "Print recent auto-retry log lines.",
        "contexts": [
          "global"
        ],
        "command": [
          "/bin/sh",
          "launch.sh",
          "logs"
        ]
      },
      {
        "id": "status",
        "title": "Claude Auto Retry: status",
        "description": "Show active monitors and recent activity.",
        "contexts": [
          "global"
        ],
        "command": [
          "/bin/sh",
          "launch.sh",
          "status"
        ]
      },
      {
        "id": "stop",
        "title": "Claude Auto Retry: stop all",
        "description": "Stop all auto-retry monitors.",
        "contexts": [
          "global"
        ],
        "command": [
          "/bin/sh",
          "launch.sh",
          "stop"
        ]
      },
      {
        "id": "watch-all",
        "title": "Claude Auto Retry: watch all Claude panes",
        "description": "Attach an auto-retry monitor to every running Claude Code pane.",
        "contexts": [
          "global"
        ],
        "command": [
          "/bin/sh",
          "launch.sh",
          "watch-all"
        ]
      }
    ],
    "events": [
      {
        "on": "pane.agent_detected",
        "command": [
          "/bin/sh",
          "launch.sh",
          "hook-agent-detected"
        ]
      },
      {
        "on": "pane.agent_status_changed",
        "command": [
          "/bin/sh",
          "launch.sh",
          "hook-agent-detected"
        ]
      }
    ],
    "source": {
